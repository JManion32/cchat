{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Local development",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
